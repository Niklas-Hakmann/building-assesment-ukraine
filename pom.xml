<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.buildingassessment</groupId>
    <artifactId>building-assessment</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Building Assessment Ukraine — Sensor Dashboard</name>
    <description>
        JPMS plugin architecture: shared contracts in `common`, the host and dashboard
        in `core`, and one drop-in module per sensor type discovered at runtime from
        `plugins/`.
    </description>

    <modules>
        <module>common</module>
        <module>core</module>
        <!-- Sensor plugins. Adding one here is the only build-level change a new
             sensor type needs; no existing module is touched. -->
        <module>sensor-vibration</module>
        <module>sensor-temperature</module>
        <module>building</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Where a module's own JAR is installed. The boot layer by default;
             sensor plugins override this to ../plugins so ServiceLocator
             discovers them at runtime instead of resolving them at startup. -->
        <module.outputDir>${project.basedir}/../mods-mvn</module.outputDir>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.buildingassessment</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.6.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.3.2</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- `mvn -N exec:exec` — boot layer from mods-mvn/, sensor plugins
                 discovered from plugins/ by ServiceLocator at runtime. The -N
                 matters: the goal is configured on this project only, so letting
                 the CLI descend into the modules would fail on a missing
                 executable.

                 Fails until core.server.Main exists. Add program arguments as
                 further <argument> entries once Main takes any. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <goals><goal>exec</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <arguments>
                        <!-- Windows consoles default to a legacy codepage for
                             stdout, which mangles the non-ASCII characters in
                             sensor names. file.encoding alone does not cover it. -->
                        <argument>-Dstdout.encoding=UTF-8</argument>
                        <argument>-Dstderr.encoding=UTF-8</argument>
                        <argument>--module-path=mods-mvn</argument>
                        <argument>--add-modules=ALL-MODULE-PATH</argument>
                        <argument>--module=com.buildingassessment.core/com.buildingassessment.core.server.Main</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Root pom (no src/): clean both runtime directories. -->
        <profile>
            <id>parent-project</id>
            <activation>
                <file><missing>src</missing></file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-clean-plugin</artifactId>
                        <configuration>
                            <filesets>
                                <fileset><directory>mods-mvn</directory></fileset>
                                <fileset>
                                    <directory>plugins</directory>
                                    <excludes><exclude>.gitkeep</exclude></excludes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Child modules: install the JAR into the layer it belongs to. -->
        <profile>
            <id>child-project</id>
            <activation>
                <file><exists>src</exists></file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-module-jar</id>
                                <phase>install</phase>
                                <goals><goal>copy</goal></goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>${project.groupId}</groupId>
                                            <artifactId>${project.artifactId}</artifactId>
                                            <version>${project.version}</version>
                                            <type>jar</type>
                                        </artifactItem>
                                    </artifactItems>
                                    <outputDirectory>${module.outputDir}</outputDirectory>
                                </configuration>
                            </execution>
                            <!-- Third-party runtime deps always go in the boot layer:
                                 a plugin's own JAR may live in plugins/, but the
                                 libraries it reads must be resolvable from the boot
                                 configuration the plugin layer is derived from. -->
                            <execution>
                                <id>copy-external-deps</id>
                                <phase>install</phase>
                                <goals><goal>copy-dependencies</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.basedir}/../mods-mvn</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                    <excludeGroupIds>com.buildingassessment</excludeGroupIds>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
